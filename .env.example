# Flask/Gunicorn port inside the container.
PORT=8437

# Host port used by Docker Compose.
HOST_PORT=8437

# Comma-separated origins allowed to call /predict from another origin.
# Same-origin requests from this Flask app do not need CORS.
CORS_ORIGINS=https://heartdp.beytullahp.com,http://heartdp.beytullahp.com
